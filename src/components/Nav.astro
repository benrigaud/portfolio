<style>
	.nav-sentinel {
		height: 0;
	}

	.nav-spacer {
		height: 0;
	}

	.nav{
		img{
			display: none;
		}

		nav {
			display: flex;
			align-items: center;
			gap: 1rem;
		}
	}

	.nav.is-stuck {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		background-color: var(--color-white);
		border-bottom: 1px solid var(--color-border);
		display: flex;
		img{
			display: block;
		}

		.nav__inner {
			justify-content: flex-start;
		}
	}

	.nav__inner {
		width: 100%;
		max-width: var(--container-width);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.nav__links {
		list-style: none;
		display: flex;
		gap: 1.5rem;
		margin: 0;
		padding: 100px 0 0;
	}

	.nav.is-stuck .nav__links {
		padding: 1rem 1.5rem;
	}

	.nav__links a {
		color: var(--color-black);
		text-decoration: underline;
		font-family: var(--font-hurin);
		font-size: 18px;
		transition: color 0.2s ease;
	}

	.nav__links a:hover {
		color: var(--color-blue);
	}
</style>
