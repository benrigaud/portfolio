---
// TODO: swap in real profile URLs
const linkedinHref = 'https://linkedin.com/in/benrigaud';
const dribbbleHref = 'https://dribbble.com/benrigaud';
const githubHref = 'https://github.com/benrigaud';
---

<section id="about" class="section about">
	<div class="section__inner">
		<p class="section__title" data-reveal>About</p>
		<h3 class="about_name" data-reveal>Ben Rigaud</h3>
		<p class="about_bio" data-reveal style="--reveal-delay: 0.1s;">Hi, I’m Ben. For the past 7+ years, I’ve been designing and building things for the web. I’m happiest somewhere between Figma and the browser—creating thoughtful interfaces and bringing them to life with code.</p>
		<ul class="about_socials" data-reveal style="--reveal-delay: 0.2s;">			
			<li>
				<a href={dribbbleHref} aria-label="Dribbble" target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="10" />
						<path d="M8.56 2.75c4.37 6.03 6.02 9.42 8.03 17.72" />
						<path d="M19.13 4.99c-3.72 4.35-8.94 5.66-16.88 5.85" />
						<path d="M21.63 12.79c-3.5-.93-6.63-.82-8.94 0-2.58.92-5.01 2.86-7.44 6.32" />
					</svg>
				</a>
			</li>
			<li>
				<a href={githubHref} aria-label="GitHub" target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.754-1.333-1.754-1.089-.744.084-.729.084-.729 1.205.084 1.84 1.236 1.84 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.775.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12z" />
					</svg>
				</a>
			</li>
			<li>
				<a href={linkedinHref} aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
					</svg>
				</a>
			</li>
		</ul>
	</div>
</section>

<style>
	.section.about{
		background-color: var(--color-black);
	}
	.about_name{
		font-size: 60px;
		margin: 0 0 40px;
		color: #fff;
		font-family: var(--font-hurin);
		font-weight: 400;
	}

	@media (max-width: 640px) {
		.about_name{
			font-size: 40px;
		}
	}
	.about_bio{
		font-size: 18px;
		color: #fff;
		line-height: 1.6;
	}

	.about_socials {
		list-style: none;
		display: flex;
		gap: 1.5rem;
		margin: 2rem 0 0;
		padding: 0;
	}

	.about_socials a {
		display: block;
		color: var(--color-blue);
		transition: color 0.2s;
	}

	.about_socials a:hover {
		color: var(--color-white);
	}

	.about_socials svg {
		width: 35px;
		height: 35px;
	}
</style>