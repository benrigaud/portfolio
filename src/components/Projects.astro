---
import figmaIcon from '../icons/icon-figma.svg?raw';
import astroIcon from '../icons/icon-astro.svg?raw';
import reactIcon from '../icons/icon-react.svg?raw';
import htmlIcon from '../icons/icon-html.svg?raw';
import cssIcon from '../icons/icon-css.svg?raw';
import jsIcon from '../icons/icon-js.svg?raw';
import illustratorIcon from '../icons/icon-illustrator.svg?raw';

import avinutMain from '../images/projects/avinut/main.webp';
import avinutCompare from '../images/projects/avinut/compare.webp';
import avinutIcon from '../images/projects/avinut/icon.png';
import avinutMono from '../images/projects/avinut/mono.webp';

import avinutWebsiteHomeFull from '../images/projects/avinut-website/home-full.webp';
import avinutWebsiteProductHome from '../images/projects/avinut-website/product-home.webp';
import avinutWebsiteShot from '../images/projects/avinut-website/shot.webp';
import avinutAnimation from '../images/projects/avinut-website/avinut-animation.gif';

import gobeconFull from '../images/projects/gobecon/full.webp';
import gobeconShot from '../images/projects/gobecon/shot.webp';

import portfolioFull from '../images/projects/portfolio/full.webp';
import portfolioShot from '../images/projects/portfolio/shot.webp';

// TODO: swap description / demoHref / githubHref / images placeholders for the real thing
const projects = [
	{
		title: 'Avinut Ecommerce',
		description: 'A custom Shopify storefront built for Avinut, covering everything from product pages to checkout.',
		demoHref: 'https://benrigaud.github.io/avinut/',
		githubHref: 'https://github.com/benrigaud/avinut',
		images: [avinutWebsiteHomeFull.src, avinutWebsiteProductHome.src],
		facets: [{ type: ['Design', 'Development'], icons: ['Figma', 'React'], image: avinutWebsiteShot.src }],
	},
	{
		title: 'Avinut Logo Redesign',
		description: 'A full brand refresh for Avinut, starting from the logo and extending into a small identity system.',
		demoHref: '',
		githubHref: '',
		images: [avinutIcon.src, avinutCompare.src, avinutMain.src, avinutMono.src],
		facets: [{ type: 'Design', icons: ['illustrator'], image: avinutIcon.src }],
	},
	{
		title: 'Gobecon Website',
		description: 'A marketing site for Gobecon, designed in Figma and built as a fast, static HTML/CSS/JS front end.',
		demoHref: 'https://benrigaud.github.io/gobecon/',
		githubHref: 'https://github.com/benrigaud/gobecon',
		images: [gobeconFull.src],
		facets: [{ type: ['Design', 'Development'], icons: ['figma', 'html', 'css', 'js'], image: gobeconShot.src }],
	},
	{
		title: 'Ben Rigaud Portfolio',
		description: 'This portfolio itself — designed in Figma and built with Astro, HTML, CSS and vanilla JS.',
		demoHref: '',
		githubHref: 'https://github.com/benrigaud/portfolio',
		images: [portfolioFull.src],
		facets: [{ type: ['Design', 'Development'], icons: ['figma', 'astro'], image: portfolioShot.src }],
	},
];

const facetTypes = (type) => (Array.isArray(type) ? type : [type]);
const facetLabel = (type) => facetTypes(type).join(' + ');
const facetFilterKeys = (type) => facetTypes(type).map((t) => t.toLowerCase()).join(' ');

const slugify = (str) => str.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const facetSlug = (type) =>
	facetTypes(type)
		.map(slugify)
		.sort()
		.join('-');

const filters = ['All', 'Design', 'Development'];

const placeholderImage = (title, index) => {
	const label = `${title} — ${index}`;
	const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="640" height="480" viewBox="0 0 640 480"><rect width="640" height="480" fill="#dbe9fe"/><text x="320" y="240" font-family="Montserrat, Arial, sans-serif" font-size="24" font-weight="600" fill="#272727" text-anchor="middle" dominant-baseline="middle">${label}</text></svg>`;
	return `data:image/svg+xml,${encodeURIComponent(svg)}`;
};

const icons = {
	figma: figmaIcon,
	astro: astroIcon,
	react: reactIcon,
	html: htmlIcon,
	css: cssIcon,
	js: jsIcon,
	illustrator: illustratorIcon,
};

// Flattened, JSON-serializable copy of the data the popup needs — read by the
// client script and matched back up via data-project-index / data-facet-index.
const modalData = projects.map((project) => ({
	title: project.title,
	description: project.description,
	demoHref: project.demoHref,
	githubHref: project.githubHref,
	images: Array.isArray(project.images)
		? project.images
		: Array.from({ length: project.images ?? 0 }, (_, idx) => placeholderImage(project.title, idx + 1)),
	facets: project.facets.map((facet) => ({
		label: facetLabel(facet.type),
		iconsHtml: facet.icons.map((icon) => icons[icon.toLowerCase()] || '').join(''),
	})),
}));
// Escape "<" so no string (icon markup, description, …) can prematurely close the <script> tag.
const modalDataJson = JSON.stringify(modalData).replace(/</g, '\\u003c');
---

<section id="projects" class="section projects">
	<div class="section__inner">
		<h2 class="section__title">projects</h2>
		<p class="projects__filter" data-project-filter>
			<span class="projects__filter-label">Filter:</span>
			{
				filters.map((filter) => (
					<button
						type="button"
						class={`projects__filter-btn${filter === 'All' ? ' is-active' : ''}`}
						data-filter={filter.toLowerCase()}
					>
						{filter.toLowerCase()}
					</button>
				))
			}
		</p>
		<div class="projects__list">
			{
				projects.map((project, i) => (
					<article class="project" data-reveal style={`--reveal-delay: ${i * 0.1}s;`}>
						<div class="project__grid">
							{project.facets.map((facet, fi) => (
								<button
									type="button"
									class="project-card"
									data-facet-types={facetFilterKeys(facet.type)}
									data-project-index={i}
									data-facet-index={fi}
								>
									<p class="project-card__label">{facetLabel(facet.type)}</p>
									<span class={`project-card__media project-card__media--${facetSlug(facet.type)}`}>
										{
											facet.image ? (
												<>
													<img src={facet.image} alt={`${project.title} preview`} loading="lazy" />
													{project.title === 'Avinut Ecommerce' && (
														<img
															class="project-card__animation"
															src={avinutAnimation.src}
															alt=""
															aria-hidden="true"
														/>
													)}
												</>
											) : (
												// TODO: swap for a real screenshot / design image
												<Fragment />
											)
										}
									</span>
									<span class="project-card__footer">
										<span class="project-card__title">{project.title}</span>
										<span class="project-card__icons">
											{facet.icons.map((icon) => <Fragment set:html={icons[icon.toLowerCase()]} />)}
										</span>
									</span>
								</button>
							))}
						</div>
					</article>
				))
			}
		</div>
	</div>

	<script type="application/json" id="projects-data" set:html={modalDataJson} />

	<dialog class="project-modal" data-project-modal>
		<button type="button" class="project-modal__close" data-modal-close aria-label="Close">×</button>
		<p class="project-modal__type" data-modal-type />
		<h3 class="project-modal__title" data-modal-title />
		<div class="project-modal__icons" data-modal-icons />
		<p class="project-modal__description" data-modal-description />
		<p class="project-modal__gallery-hint">Click to enlarge</p>
		<div class="project-modal__gallery" data-modal-gallery />
		<p class="project-modal__links" data-modal-links>
			<a class="project-modal__link" data-modal-demo target="_blank" rel="noopener noreferrer">
				Live demo
			</a>
			<a class="project-modal__link" data-modal-github target="_blank" rel="noopener noreferrer">
				GitHub
			</a>
		</p>
	</dialog>

	<dialog class="project-lightbox" data-project-lightbox>
		<button type="button" class="project-lightbox__close" data-lightbox-close aria-label="Close image">×</button>
		<img class="project-lightbox__image" data-lightbox-image alt="" />
	</dialog>
</section>

<script>
	// Filters project cards by facet type ("design" / "development").
	// "all" clears the filter and shows everything.
	const filterBar = document.querySelector('[data-project-filter]');
	const filterButtons = document.querySelectorAll('[data-project-filter] [data-filter]');
	const projectEls = document.querySelectorAll('.project');

	if (filterBar && filterButtons.length) {
		let activeFilter = null;

		const applyFilter = () => {
			projectEls.forEach((project) => {
				let anyVisible = false;

				project.querySelectorAll('.project-card').forEach((card) => {
					const types = (card.dataset.facetTypes || '').split(' ');
					const visible = !activeFilter || types.includes(activeFilter);
					card.classList.toggle('is-hidden', !visible);
					if (visible) anyVisible = true;
				});

				project.classList.toggle('is-hidden', !anyVisible);
			});
		};

		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const value = button.dataset.filter;
				activeFilter = value === 'all' ? null : value;

				filterButtons.forEach((btn) => {
					btn.classList.toggle('is-active', btn === button);
				});

				applyFilter();
			});
		});
	}

	// Project popup: clicking a facet card opens a modal with that project's
	// title, type, icons, description, a gallery (click a thumbnail to
	// magnify), and live-demo / GitHub links.
	const dataEl = document.getElementById('projects-data');
	const modalData = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

	const dialog = document.querySelector('[data-project-modal]');
	const cards = document.querySelectorAll('.project-card');

	if (dialog && cards.length && modalData.length) {
		const modalType = dialog.querySelector('[data-modal-type]');
		const modalTitle = dialog.querySelector('[data-modal-title]');
		const modalIcons = dialog.querySelector('[data-modal-icons]');
		const modalDescription = dialog.querySelector('[data-modal-description]');
		const modalGallery = dialog.querySelector('[data-modal-gallery]');
		const modalDemo = dialog.querySelector('[data-modal-demo]');
		const modalGithub = dialog.querySelector('[data-modal-github]');
		const modalLinks = dialog.querySelector('[data-modal-links]');

		const lightbox = document.querySelector('[data-project-lightbox]');
		const lightboxImage = lightbox?.querySelector('[data-lightbox-image]');

		cards.forEach((card) => {
			card.addEventListener('click', () => {
				const project = modalData[Number(card.dataset.projectIndex)];
				const facet = project?.facets[Number(card.dataset.facetIndex)];
				if (!project || !facet || !modalType || !modalTitle || !modalIcons || !modalDescription || !modalGallery) return;

				modalType.textContent = facet.label;
				modalTitle.textContent = project.title;
				modalIcons.innerHTML = facet.iconsHtml;
				modalDescription.textContent = project.description;
				let anyLinkVisible = false;
				if (modalDemo) {
					modalDemo.hidden = !project.demoHref;
					if (project.demoHref) {
						modalDemo.href = project.demoHref;
						anyLinkVisible = true;
					}
				}
				if (modalGithub) {
					modalGithub.hidden = !project.githubHref;
					if (project.githubHref) {
						modalGithub.href = project.githubHref;
						anyLinkVisible = true;
					}
				}
				if (modalLinks) modalLinks.hidden = !anyLinkVisible;

				modalGallery.classList.toggle('is-design-only', facet.label === 'Design');

				modalGallery.innerHTML = '';
				project.images.forEach((src, n) => {
					const thumb = document.createElement('button');
					thumb.type = 'button';
					thumb.className = 'project-modal__thumb';
					thumb.setAttribute('aria-label', `Enlarge image ${n + 1}`);
					thumb.dataset.fullSrc = src;

					const img = document.createElement('img');
					img.src = src;
					img.alt = `${project.title} — screenshot ${n + 1}`;
					img.loading = 'lazy';
					thumb.appendChild(img);

					modalGallery.appendChild(thumb);
				});

				dialog.showModal();
			});
		});

		dialog.querySelectorAll('[data-modal-close]').forEach((btn) => {
			btn.addEventListener('click', () => dialog.close());
		});

		// Click on the dialog's own backdrop area (not its content) closes it.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		modalGallery?.addEventListener('click', (event) => {
			const thumb = event.target instanceof Element ? event.target.closest('.project-modal__thumb') : null;
			if (!thumb || !lightbox || !lightboxImage) return;
			lightboxImage.src = thumb.dataset.fullSrc || '';
			lightboxImage.alt = thumb.querySelector('img')?.alt || '';
			lightboxImage.classList.remove('is-zoomed');
			lightbox.classList.remove('is-zoomed');
			lightbox.showModal();
		});

		if (lightbox) {
			lightbox.querySelectorAll('[data-lightbox-close]').forEach((btn) => {
				btn.addEventListener('click', () => {
					lightbox.close();
				});
			});

			lightbox.addEventListener('click', (event) => {
				if (event.target === lightbox) lightbox.close();
			});

			// Click the image itself to zoom in (scroll to pan); click again to fit.
			// Resizing it for real (rather than a CSS transform) is what makes the
			// container's overflow — and therefore scrolling to pan — actually work.
			lightboxImage?.addEventListener('click', (event) => {
				event.stopPropagation();
				const zoomed = lightboxImage.classList.toggle('is-zoomed');
				lightbox.classList.toggle('is-zoomed', zoomed);

				if (zoomed && lightboxImage.naturalWidth) {
					lightboxImage.style.width = `${lightboxImage.naturalWidth * 2}px`;
					lightboxImage.style.height = `${lightboxImage.naturalHeight * 2}px`;
					// Center the view on the now-larger image instead of snapping to
					// the top-left corner.
					requestAnimationFrame(() => {
						lightbox.scrollLeft = (lightbox.scrollWidth - lightbox.clientWidth) / 2;
						lightbox.scrollTop = (lightbox.scrollHeight - lightbox.clientHeight) / 2;
					});
				} else {
					lightboxImage.style.width = '';
					lightboxImage.style.height = '';
				}
			});

			// If Escape is pressed while the lightbox is open, let it handle Escape
			// (and close) on its own — stop the project modal underneath from also
			// closing on the same keypress. A second Escape then closes the modal.
			dialog.addEventListener('cancel', (event) => {
				if (lightbox.open) event.preventDefault();
			});
		}
	}
</script>

<style>
	.projects__filter {
		display: flex;
		align-items: center;
		gap: 40px;
		margin: 0 0 50px;
		font-family: var(--font-sans);
		font-size: 16px;
		font-weight: 600;
	}

	.projects__filter-label {
		color: var(--color-black);
	}

	.projects__filter-btn {
		padding: 0;
		border: none;
		background: none;
		font: inherit;
		color: var(--color-black);
		text-decoration: underline;
		cursor: pointer;
	}

	.projects__filter-btn:hover {
		color: var(--color-blue);
	}

	.projects__filter-btn.is-active {
		color: var(--color-blue);
	}

	.project.is-hidden,
	.project-card.is-hidden {
		display: none;
	}

	.projects__list {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(3rem, 6vw, 4.5rem);
	}

	@media (min-width: 768px) {
		.projects__list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.project__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2.5rem;
	}

	.project-card {
		display: flex;
		flex-direction: column;
		width: 100%;
		margin: 0;
		padding: 0;
		border: none;
		background: none;
		color: inherit;
		text-decoration: none;
		text-align: inherit;
		font: inherit;
		cursor: pointer;
	}

	.project-card__label {
		margin: 0 0 0.75rem;
		color: var(--color-blue);
		font-weight: 600;
		text-align: right;
	}

	.project-card__media {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		transition: transform 0.2s ease;
	}

	.project-card__animation {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	.project-card:hover .project-card__animation {
		opacity: 1;
	}

	.project-card__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	.project-card__media--development {
		background: #dbe9fe;
	}

	.project-card__media--design {
		background: var(--color-white);
		border: 1px solid var(--color-border);
	}

	.project-card__media--design img {
		object-position: center;
	}

	.project-card__media--design-development {
		background: linear-gradient(135deg, #dbe9fe 50%, var(--color-white) 50%);
		border: 1px solid var(--color-border);
	}

	.project-card__media--design,
	.project-card__media--design-development {
		aspect-ratio: 1 / 0.8;
	}

	.project-card:hover .project-card__media {
		transform: translateY(-4px);
	}

	.project-card__footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 1rem;
	}

	.project-card__title {
		font-weight: 700;
		font-size: 1.15rem;
		color: var(--color-black);
		transition: color 0.2s ease;
	}

	.project-card__icons {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-shrink: 0;
		color: var(--color-black);
	}

	.project-card__icons svg {
		width: 20px;
		height: 20px;
	}

	/* Icons are inlined SVGs (via set:html) with their own hardcoded
	   stroke/fill (not currentColor), so recolor those attributes directly on
	   hover instead of relying on `color` inheritance. The "white" fills are
	   inner logo detail (e.g. the JS/HTML/CSS marks) and are left alone.
	   :global() on the svg-and-below part — like `.project-modal__thumb`
	   above, that markup is injected raw and never gets the scoped
	   data-astro-cid attribute a normal (scoped) selector here would require. */
	.project-card:hover .project-card__title {
		color: var(--color-blue);
	}

	.project-card:hover .project-card__icons :global(svg [fill="#272727"]),
	.project-card:hover .project-card__icons :global(svg [fill="black"]) {
		fill: var(--color-blue);
	}

	.project-card:hover .project-card__icons :global(svg [stroke="#272727"]) {
		stroke: var(--color-blue);
	}

	.project-card__icons :global(svg [fill="#272727"]),
	.project-card__icons :global(svg [fill="black"]) {
		transition: fill 0.2s ease;
	}

	.project-card__icons :global(svg [stroke="#272727"]) {
		transition: stroke 0.2s ease;
	}

	.project-modal {
		position: fixed;
		inset: 0;
		margin: auto;
		width: 95vw;
		height: 90vh;
		max-width: none;
		overflow-y: auto;
		border: none;
		padding: 2.5rem;
		color: var(--color-black);
		background: var(--color-sand);
	}

	.project-modal::backdrop {
		background: rgba(0, 0, 0, 0.5);
	}

	.project-modal__close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		border: none;
		background: none;
		font-size: 1.75rem;
		line-height: 1;
		color: var(--color-black);
		cursor: pointer;
	}

	.project-modal__type {
		margin: 0 0 0.25rem;
		color: var(--color-blue);
		font-weight: 600;
	}

	.project-modal__title {
		margin: 0 0 1rem;
		font-size: 1.5rem;
	}

	.project-modal__icons {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
		color: var(--color-black);
	}

	.project-modal__icons svg {
		width: 22px;
		height: 22px;
	}

	.project-modal__description {
		margin: 0 0 1.5rem;
		line-height: 1.5;
	}

	.project-modal__gallery-hint {
		margin: 0 0 0.5rem;
		color: var(--color-text-muted, #6b7280);
		font-size: 0.85rem;
	}

	.project-modal__gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}

	/* A lone image shouldn't stretch across (or sit left in) the 2-col grid — center it instead.
	   Whole selector wrapped in :global() — Astro's scoping doesn't support :global()
	   nested inside :has(), so it has to apply at the top level here. */
	:global(.project-modal__gallery:has(> .project-modal__thumb:only-child)) {
		grid-template-columns: 1fr;
		justify-items: center;
	}

	:global(.project-modal__gallery:has(> .project-modal__thumb:only-child) .project-modal__thumb) {
		width: 100%;
		max-width: 560px;
	}

	/* :global() — these thumb buttons/images are created at runtime via
	   document.createElement(), not by the Astro template, so they never get
	   the scoped data-astro-cid attribute a normal (scoped) rule here would
	   require to match. */
	:global(.project-modal__thumb) {
		-webkit-appearance: none;
		-moz-appearance: none;
		appearance: none;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		padding: 0;
		background-color: #fff;
		border: solid 1px #fff;
		border-radius: 0;
		outline: none;
		box-shadow: none;
		cursor: zoom-in;
	}

	:global(.project-modal__thumb img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	/* "Design"-only facets (no combined Development) get contain + centered,
	   matching the card preview's treatment for the same case. */
	.project-modal__gallery.is-design-only :global(.project-modal__thumb img) {
		object-fit: contain;
		object-position: center;
	}

	.project-modal__links {
		display: flex;
		gap: 1.5rem;
		margin: 0;
	}

	.project-modal__link {
		color: var(--color-blue);
		font-weight: 600;
		text-decoration: underline;
	}

	.project-modal__link:hover {
		color: var(--color-black);
	}

	.project-lightbox {
		position: fixed;
		inset: 0;
		margin: 0;
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		border: none;
		padding: 0;
		background: rgba(0, 0, 0, 0.8);
	}

	.project-lightbox[open] {
		display: flex;
		align-items: center;
