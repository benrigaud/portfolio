---
// TODO: content — replace with real projects (title, description, link, image/tags)
const projects = [
	{ title: 'Project One', description: 'Short description goes here.', href: '#' },
	{ title: 'Project Two', description: 'Short description goes here.', href: '#' },
	{ title: 'Project Three', description: 'Short description goes here.', href: '#' },
];
---

<section id="projects" class="section projects">
	<div class="section__inner">
		<h2 class="section__title">Projects</h2>
		<div class="projects__grid">
			{
				projects.map((project) => (
					<a class="project-card" href={project.href}>
						<h3>{project.title}</h3>
						<p>{project.description}</p>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.projects__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.5rem;
	}

	.project-card {
		display: block;
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 12px;
		color: inherit;
		text-decoration: none;
		transition: border-color 0.2s;
	}

	.project-card:hover {
		border-color: var(--color-accent);
	}

	.project-card h3 {
		margin: 0 0 0.5rem;
	}

	.project-card p {
		margin: 0;
		color: var(--color-text-muted);
	}
</style>
