---
import Nav from './Nav.astro';
import logo from '../images/logo.png';
---

<section id="hero" class="section hero">
	<div class="section__inner hero__inner">
		<img class="hero__logo fade-up-in" src={logo.src} width="40" height="auto" alt="Logo" />
		<h1 class="fade-up-in" style="animation-delay: 0.15s;">
			Front-end <br>
			developer and <br>
			designer<span>.</span>
		</h1>
		<Nav />
	</div>
</section>

<style>
	.hero {
		min-height: 90vh;
		display: flex;
		align-items: center;
		line-height: 1;
		background-color: var(--color-sand);
	}

	.hero__inner {
		text-align: left;
		margin-inline: auto;
	}

	.hero__logo {
		margin-bottom: 1.5rem;
		margin-top: 40px;
	}

	.hero h1 {
		font-size: clamp(4rem, 10vw, 8rem);
		margin: 0 0 0.5rem;
		font-family: var(--font-hurin);
		font-weight: 400;
		span{
			color: var(--color-blue);
		}
	}
</style>
