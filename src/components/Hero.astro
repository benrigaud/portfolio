---

<section id="hero" class="section hero">
	<div class="section__inner hero__inner">
		<h1>Your Name</h1>
		<p class="hero__tagline">Tagline / what you do goes here.</p>
	</div>
</section>

<style>
	.hero {
		min-height: 90vh;
		display: flex;
		align-items: center;
	}

	.hero__inner {
		text-align: center;
		margin-inline: auto;
	}

	.hero h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		margin: 0 0 0.5rem;
	}

	.hero__tagline {
		font-size: clamp(1.1rem, 2vw, 1.4rem);
		color: var(--color-text-muted);
		margin: 0;
	}
</style>
