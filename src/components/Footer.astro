---
import logo from '../images/logo.png';

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="section__inner footer__inner">
		<p>&copy; {year} Benrigaud | Front-end developer and designer.</p>
		<img class="footer__logo" src={logo.src} width="20" height="auto" alt="Logo" />
	</div>
</footer>

<style>
	.footer {
		padding: 2rem 1.5rem;
	}

	.footer__inner {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.footer__inner p {
		margin: 0;
	}

	.footer__logo {
		flex-shrink: 0;
	}
</style>
