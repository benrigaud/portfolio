---
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Ben Rigaud | Dev and designer', description = 'Ben Rigaud Front-end Developer and designer' } = Astro.props;

// BASE_URL may or may not have a trailing slash depending on how `base` is
// configured in astro.config.mjs — normalize so this always joins cleanly.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Astro.site comes from the `site` option in astro.config.mjs.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Kept in sync with the social links in About.astro — no shared config for
// them yet, so update both places if a handle changes.
const sameAs = ['https://linkedin.com/in/benrigaud', 'https://dribbble.com/benrigaud', 'https://github.com/benrigaud'];

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Ben Rigaud',
	jobTitle: 'Front-end Developer and Designer',
	url: canonicalURL.toString(),
	sameAs,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Ben Rigaud" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<!-- TODO: once a proper 1200x630 social-preview image exists (e.g.
		     public/og-image.png), add og:image / twitter:image (switch
		     twitter:card to "summary_large_image") pointing at it. -->

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	</head>
	<body>
		<slot />
		<Cursor />
	</body>
</html>

<script>
	// Site-wide scroll reveal: any element with [data-reveal] fades/slides in
	// once it enters the viewport, then stops being observed (reveals once).
	const revealEls = document.querySelectorAll('[data-reveal]');

	if ('IntersectionObserver' in window && revealEls.length) {
		const observer = new IntersectionObserver(
			(entries, obs) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						obs.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.2 },
		);

		revealEls.forEach((el) => observer.observe(el));
	} else {
		// No IntersectionObserver support — just show everything.
		revealEls.forEach((el) => el.classList.add('is-visible'));
	}
</script>
