---
import Layout from '../layouts/Layout.astro';

// Matches Layout.astro's own BASE_URL normalization, so this link is correct
// whether the site is served from the root or a sub-path.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Page not found | Ben Rigaud" description="This page doesn't exist.">
	<section class="not-found">
		<div class="section__inner not-found__inner">
			<p class="not-found__code">404</p>
			<h1 class="not-found__title">Page not found</h1>
			<p class="not-found__text">The page you're looking for doesn't exist or has moved.</p>
			<a class="not-found__link" href={`${base}/`}>Back to home</a>
		</div>
	</section>
</Layout>

<style>
	.not-found {
		min-height: 90vh;
		display: flex;
		align-items: center;
		background-color: var(--color-sand);
	}

	.not-found__inner {
		text-align: center;
	}

	.not-found__code {
		margin: 0;
		font-family: var(--font-hurin);
		font-weight: 400;
		font-size: clamp(4rem, 14vw, 9rem);
		line-height: 1;
		color: var(--color-blue);
	}

	.not-found__title {
		margin: 0.5rem 0 1rem;
		font-family: var(--font-hurin);
		font-weight: 400;
		font-size: clamp(1.75rem, 5vw, 2.5rem);
		color: var(--color-text);
	}

	.not-found__text {
		margin: 0 0 2rem;
		color: var(--color-text-muted);
	}

	.not-found__link {
		display: inline-block;
		font-weight: 700;
		color: var(--color-blue);
		text-decoration: underline;
		transition: color 0.2s ease;
	}

	.not-found__link:hover {
		color: var(--color-black);
	}
</style>
